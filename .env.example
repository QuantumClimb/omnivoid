# ============================================
# OMNIVOID LABS - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================

# --------------------------------------------
# Database - Neon PostgreSQL
# --------------------------------------------
# The DATABASE_URL is automatically set by Vercel-Neon integration
# Format: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# For local development, get from Neon dashboard > Connection Details
DATABASE_URL=""

# DATABASE_URL_UNPOOLED is used for migrations (direct connection)
# This is also automatically set by Vercel-Neon integration
DATABASE_URL_UNPOOLED=""

# --------------------------------------------
# Authentication
# --------------------------------------------
# JWT_SECRET: Generate a strong random secret key
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ADMIN_PASSWORD: Set a strong password for the admin dashboard
# This password will be hashed with bcrypt before storage
# Minimum 8 characters
ADMIN_PASSWORD=""

# Neon Auth Configuration (Optional)
# AUTH_URL: Your Neon Auth endpoint URL
# Format: https://<project>.neonauth.c-<region>.aws.neon.tech/<db>/auth
AUTH_URL=""

# JWKS_URL: Your Neon Auth JWKS endpoint for token verification
# Format: https://<project>.neonauth.c-<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
JWKS_URL=""

# --------------------------------------------
# Application
# --------------------------------------------
# NEXT_PUBLIC_API_URL: Your API base URL
# For development: http://localhost:3000/api
# For production: https://your-domain.vercel.app/api
NEXT_PUBLIC_API_URL=""

# --------------------------------------------
# Optional: Google Drive Integration
# --------------------------------------------
# If using Google Drive for file storage
# GOOGLE_DRIVE_API_KEY=""
# GOOGLE_DRIVE_FOLDER_ID=""

# --------------------------------------------
# Optional: Additional Services
# --------------------------------------------
# For file uploads (if not using Google Drive)
# UPLOAD_DIR="./uploads"
# MAX_FILE_SIZE="10485760"

# For rate limiting
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX_REQUESTS="100"